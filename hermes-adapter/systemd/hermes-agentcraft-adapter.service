# systemd --user unit for the read-only Hermes -> AgentCraft adapter.
#
# NOT installed or enabled by the build. To deploy (Eli's call), copy to
# ~/.config/systemd/user/hermes-agentcraft-adapter.service, adjust the paths/peer, then:
#   systemctl --user daemon-reload && systemctl --user enable --now hermes-agentcraft-adapter
#
# It binds ai-ops' LAN address and admits exactly one peer (the gaming-spare test server).
[Unit]
Description=AgentCraft adapter: read-only Hermes state over the AgentCraft WebSocket protocol
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/agentcraft-gtnh/hermes-adapter
ExecStart=/usr/bin/python3 -m hermes_adapter --bind 192.0.2.10 --port 7878 --allow-peer 192.0.2.20 --poll 3
# Ops feeds (docs/ops-protocol.md): add one or more private source plugins, e.g.
#   ExecStart=/usr/bin/python3 -m hermes_adapter ... --ops-plugin %h/private/ops_plugin --ops-config %h/private/ops.json
# IP addresses in text stay redacted unless --allow-ip-text is added.
Restart=on-failure
RestartSec=10
# read-only by design: the adapter opens every DB with mode=ro + query_only. The home directory
# must stay WRITABLE for SQLite's coordination files, so ProtectSystem=full (only /usr, /boot,
# /efi and /etc read-only) and NOT strict, and no ProtectHome=read-only: on a read-only home a
# mode=ro reader cannot open a quiescent WAL-mode kanban.db (no -shm file yet), and the adapter
# exits with "unable to open database file" (reproduced in a read-only mount namespace). The
# database files themselves are never modified. Ops plugins that read /tmp need PrivateTmp=no.
# Untested as a unit: verify on install with `journalctl --user -u hermes-agentcraft-adapter`.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
MemoryMax=256M
CPUQuota=25%

[Install]
WantedBy=default.target
